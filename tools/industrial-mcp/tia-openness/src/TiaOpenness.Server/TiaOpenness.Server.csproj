<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Siemens.Engineering is .NET Framework 4.8 (Remoting). Must not run on net8+. -->
    <TargetFramework>net481</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>TiaOpenness.Server</RootNamespace>
    <AssemblyName>TiaOpenness.Server</AssemblyName>
    <LangVersion>latest</LangVersion>
    <Description>ResearchOS MCP server for Siemens TIA Portal Openness (V19).</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="ModelContextProtocol" Version="2.1.0" />
    <PackageReference Include="System.Text.Json" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\TiaOpenness.Models\TiaOpenness.Models.csproj" />
  </ItemGroup>

</Project>
