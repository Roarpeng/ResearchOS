# ResearchOS environment template — copy to .env and replace change_me_* values.
# Do NOT commit real secrets.

# ---- Runtime / environment ----
ENV=dev
LOG_LEVEL=INFO

# ---- Data plane ----
POSTGRES_PASSWORD=change_me_pg
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://researchos:change_me_pg@localhost:5432/researchos

REDIS_URL=redis://localhost:6379/0
REDIS_PORT=6379

MINIO_ROOT_USER=rosminio
MINIO_ROOT_PASSWORD=change_me_minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=rosapp
MINIO_SECRET_KEY=change_me_minio_app
MINIO_BUCKET_DOCUMENTS=ros-documents
MINIO_BUCKET_REPORTS=ros-reports
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

QDRANT_URL=http://localhost:6333
QDRANT_PORT=6333

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change_me_neo4j
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687

# ---- Security / Gateway ----
JWT_SECRET=change_me_use_long_random_string_at_least_32
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_TTL_SECONDS=1800
REFRESH_TTL_SECONDS=604800
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
COOKIE_SECURE=false
AUTH_API_KEYS_ENABLED=true
DEV_API_KEY=ros_ak_dev_change_me
GATEWAY_PORT=8000

# ---- Internal services ----
RUNTIME_BASE_URL=
LITELLM_BASE_URL=http://localhost:4000
LITELLM_MASTER_KEY=sk-litellm-change_me
LITELLM_DEFAULT_MODEL=default
LITELLM_PORT=4000
PUBLIC_API_BASE=http://localhost:8000
PUBLIC_WS_BASE=ws://localhost:8000

# ---- Optional components ----
OPENSEARCH_URL=
OPENSEARCH_PORT=9200
GOTENBERG_URL=
GOTENBERG_PORT=3001
N8N_HOST=localhost
N8N_WEBHOOK_URL=http://localhost:5678/
N8N_PORT=5678
OLLAMA_BASE_URL=
OLLAMA_PORT=11434
ENABLE_OPENSEARCH=false
ENABLE_PDF_EXPORT=false
ENABLE_N8N_HOOKS=false

# ---- Feature flags / app settings ----
HUMAN_INTERRUPT_DEFAULT=on_review
CITATION_REQUIRED_DEFAULT=true
MAX_TASKS_PER_HOUR=20
WS_EVENT_BUFFER_TTL_SEC=86400
INGEST_MAX_UPLOAD_MB=100
GRAPH_EXTRACT_ENABLED=true

# ---- PLC Intelligence (Gateway feature module) ----
# Semicolon-separated roots for path ingest sandbox. Empty = dev defaults (cwd/temp).
PLC_PATH_ALLOWLIST=
PLC_WORK_DIR=
PLC_UPLOAD_MAX_MB=200
# Host-side Openness (Windows only; not used inside Linux containers for .ap19)
RESEARCHOS_TIA_OPENNESS=auto
RESEARCHOS_TIA_OPENNESS_EXE=
TIA_VERSION=19.0
# Optional bind-mount for compose --profile plc (host dir → /plc_projects)
PLC_HOST_PROJECTS_DIR=./plc_projects
FRONTEND_PORT=5173

# ---- Cloud model keys (via LiteLLM only; leave empty if unused) ----
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# ---- Frontend public (non-secret) ----
NEXT_PUBLIC_API_BASE=http://localhost:8000
NEXT_PUBLIC_WS_BASE=ws://localhost:8000
NEXT_PUBLIC_APP_NAME=ResearchOS
VITE_GATEWAY_URL=